{
  "name": "Note",
  "type": "object",
  "properties": {
    "title": {
      "type": "string",
      "description": "Note title"
    },
    "content": {
      "type": "string",
      "description": "Note body text (supports basic HTML formatting)"
    },
    "color": {
      "type": "string",
      "enum": [
        "yellow",
        "pink",
        "blue",
        "green",
        "purple"
      ],
      "default": "yellow"
    },
    "pinned": {
      "type": "boolean",
      "default": false
    }
  },
  "required": [
    "content"
  ]
}
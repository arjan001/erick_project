{
  "name": "ProjectOwner",
  "type": "object",
  "properties": {
    "email": {
      "type": "string",
      "format": "email",
      "description": "Primary email for login"
    },
    "full_name": {
      "type": "string"
    },
    "company": {
      "type": "string"
    },
    "phone": {
      "type": "string"
    },
    "website": {
      "type": "string"
    },
    "profile_photo_url": {
      "type": "string",
      "description": "Profile photo URL (set in dashboard)"
    },
    "bio": {
      "type": "string",
      "description": "Short bio / about"
    },
    "language_preference": {
      "type": "string",
      "enum": [
        "en",
        "nl",
        "es"
      ],
      "default": "en"
    },
    "projects_submitted": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Project IDs submitted by this owner"
    },
    "last_active": {
      "type": "string",
      "format": "date-time",
      "description": "Last time this user was active, used for online/offline presence"
    }
  },
  "required": [
    "email",
    "full_name"
  ]
}
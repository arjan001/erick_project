{
  "name": "Artist",
  "type": "object",
  "properties": {
    "email": {
      "type": "string",
      "format": "email"
    },
    "full_name": {
      "type": "string"
    },
    "phone": {
      "type": "string",
      "description": "Mobile phone number (WhatsApp preferred)"
    },
    "role": {
      "type": "string",
      "description": "Primary specialty (free text from film roles database)"
    },
    "roles": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Multiple roles selected as tags from the film roles database"
    },
    "secondary_roles": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Additional capabilities (legacy field, superseded by roles)"
    },
    "skills_experience": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "skill": {
            "type": "string"
          },
          "years": {
            "type": "number"
          }
        }
      },
      "description": "Years of experience per skill"
    },
    "based_in_city": {
      "type": "string"
    },
    "based_in_country": {
      "type": "string"
    },
    "languages_spoken": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "portfolio_clips": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Portfolio clip IDs"
    },
    "ai_questionnaire_response": {
      "type": "object",
      "description": "AI-generated questions based on specialty with answers"
    },
    "website": {
      "type": "string"
    },
    "instagram": {
      "type": "string"
    },
    "vimeo": {
      "type": "string"
    },
    "imdb": {
      "type": "string"
    },
    "linkedin": {
      "type": "string"
    },
    "profile_photo_url": {
      "type": "string",
      "description": "Profile photo URL (set in dashboard)"
    },
    "status": {
      "type": "string",
      "enum": [
        "pending",
        "approved",
        "rejected"
      ],
      "default": "pending"
    },
    "admin_notes": {
      "type": "string"
    },
    "approved_date": {
      "type": "string",
      "format": "date"
    },
    "connects_balance": {
      "type": "number",
      "default": 5,
      "description": "Available connects to apply for jobs, like Fiverr/Upwork connects"
    },
    "last_active": {
      "type": "string",
      "format": "date-time",
      "description": "Last time this user was active, used for online/offline presence"
    },
    "invite_code": {
      "type": "string",
      "description": "Unique auto-generated invite/referral code for this user"
    },
    "referred_by": {
      "type": "string",
      "description": "Invite code of the user who referred this person"
    },
    "onboarding_completed": {
      "type": "boolean",
      "default": false,
      "description": "Whether the artist has completed the onboarding modal"
    }
  },
  "required": [
    "email",
    "full_name",
    "role"
  ]
}
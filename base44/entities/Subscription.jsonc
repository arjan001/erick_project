{
  "name": "Subscription",
  "type": "object",
  "properties": {
    "user_email": {
      "type": "string",
      "format": "email"
    },
    "user_name": {
      "type": "string"
    },
    "package_id": {
      "type": "string",
      "description": "SubscriptionPackage entity ID"
    },
    "package_name": {
      "type": "string"
    },
    "status": {
      "type": "string",
      "enum": [
        "active",
        "cancelled",
        "expired",
        "pending"
      ],
      "default": "pending"
    },
    "started_at": {
      "type": "string",
      "format": "date-time"
    },
    "renews_at": {
      "type": "string",
      "format": "date-time"
    },
    "cancelled_at": {
      "type": "string",
      "format": "date-time"
    },
    "upgraded_at": {
      "type": "string",
      "format": "date-time"
    },
    "referred_by": {
      "type": "string",
      "description": "Invite code used to claim this subscription (for Pro Beta Release)"
    }
  },
  "required": [
    "user_email",
    "package_id"
  ]
}
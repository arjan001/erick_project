{
  "name": "Message",
  "type": "object",
  "properties": {
    "conversation_id": {
      "type": "string",
      "description": "Unique ID for the conversation between two users"
    },
    "sender_email": {
      "type": "string",
      "format": "email",
      "description": "Email of message sender"
    },
    "recipient_email": {
      "type": "string",
      "format": "email",
      "description": "Email of message recipient"
    },
    "text": {
      "type": "string",
      "description": "Message text content"
    },
    "file_url": {
      "type": "string",
      "description": "Attached file URL if any"
    },
    "file_name": {
      "type": "string",
      "description": "Original file name"
    },
    "is_archived": {
      "type": "boolean",
      "default": false,
      "description": "Whether this message's conversation is archived"
    },
    "is_read": {
      "type": "boolean",
      "default": false,
      "description": "Whether the recipient has read this message"
    }
  },
  "required": [
    "conversation_id",
    "sender_email",
    "recipient_email"
  ]
}
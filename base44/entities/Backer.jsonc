{
  "name": "Backer",
  "type": "object",
  "properties": {
    "organization_name": {
      "type": "string",
      "description": "Name of organization or individual"
    },
    "contact_email": {
      "type": "string",
      "format": "email",
      "description": "Contact email (hidden from public)"
    },
    "website": {
      "type": "string",
      "description": "Organization website"
    },
    "backing_types": {
      "type": "array",
      "items": {
        "type": "string",
        "enum": [
          "sponsorship",
          "co_production",
          "cultural_support",
          "city_support",
          "investment"
        ]
      },
      "description": "Types of backing offered"
    },
    "interests": {
      "type": "array",
      "items": {
        "type": "string",
        "enum": [
          "film",
          "culture",
          "music",
          "tech",
          "sport",
          "education",
          "environmental",
          "social"
        ]
      },
      "description": "Areas of interest"
    },
    "locations": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Countries or regions of focus"
    },
    "bio": {
      "type": "string",
      "description": "Organization mission and backing philosophy"
    },
    "logo_url": {
      "type": "string",
      "description": "Logo or profile image"
    },
    "total_invested": {
      "type": "number",
      "default": 0
    },
    "investment_count": {
      "type": "number",
      "default": 0
    },
    "bank_accounts": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "status": {
      "type": "string",
      "enum": [
        "pending",
        "approved",
        "rejected"
      ],
      "default": "pending",
      "description": "Verification status"
    },
    "admin_notes": {
      "type": "string",
      "description": "Internal admin notes"
    },
    "last_active": {
      "type": "string",
      "format": "date-time",
      "description": "Last time this user was active, used for online/offline presence"
    },
    "invite_code": {
      "type": "string",
      "description": "Unique auto-generated invite/referral code"
    },
    "referred_by": {
      "type": "string",
      "description": "Invite code of the user who referred this backer"
    }
  },
  "required": [
    "organization_name",
    "contact_email"
  ]
}
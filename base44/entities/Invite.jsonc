{
  "name": "Invite",
  "type": "object",
  "properties": {
    "code": {
      "type": "string",
      "description": "Unique invite code"
    },
    "email": {
      "type": "string",
      "format": "email"
    },
    "role": {
      "type": "string",
      "enum": [
        "admin",
        "artist",
        "team",
        "client",
        "project_owner",
        "backer"
      ],
      "default": "artist"
    },
    "status": {
      "type": "string",
      "enum": [
        "pending",
        "accepted",
        "expired",
        "revoked",
        "active"
      ],
      "default": "pending"
    },
    "expires_at": {
      "type": "string",
      "format": "date-time"
    },
    "invited_by_email": {
      "type": "string",
      "format": "email"
    },
    "creator_email": {
      "type": "string",
      "format": "email",
      "description": "Email of the user who created this invite code"
    },
    "creator_type": {
      "type": "string",
      "description": "Role of the creator (artist, team, backer, etc.)"
    },
    "uses_count": {
      "type": "number",
      "default": 0,
      "description": "Number of times this invite code has been used"
    },
    "max_uses": {
      "type": "number",
      "default": 100,
      "description": "Maximum number of times this invite code can be used"
    },
    "used_by_email": {
      "type": "string",
      "format": "email",
      "description": "Email of user who used this invite code"
    },
    "team_id": {
      "type": "string",
      "description": "Team entity ID this invite joins the member to (team invites only)"
    },
    "team_name": {
      "type": "string",
      "description": "Team name, for display in the invite/email"
    },
    "member_name": {
      "type": "string",
      "description": "Name of the invited team member"
    },
    "member_role": {
      "type": "string",
      "description": "Role/specialty of the invited team member within the team"
    },
    "created_at": {
      "type": "string",
      "format": "date-time",
      "default": "now()"
    },
    "updated_at": {
      "type": "string",
      "format": "date-time",
      "default": "now()"
    }
  },
  "required": [
    "code"
  ]
}
{
  "name": "SubscriptionPackage",
  "type": "object",
  "properties": {
    "name": {
      "type": "string",
      "description": "Plan name e.g. Free, Plus, Pro"
    },
    "description": {
      "type": "string"
    },
    "price": {
      "type": "number",
      "description": "Price in EUR"
    },
    "currency": {
      "type": "string",
      "default": "EUR"
    },
    "billing_cycle": {
      "type": "string",
      "enum": [
        "monthly",
        "yearly"
      ],
      "default": "monthly"
    },
    "job_applications_limit": {
      "type": "number",
      "description": "-1 = unlimited"
    },
    "message_limit": {
      "type": "number",
      "description": "-1 = unlimited"
    },
    "connects_included": {
      "type": "number",
      "default": 0,
      "description": "Connects granted to the artist when this plan is purchased or granted"
    },
    "featured_listing": {
      "type": "boolean",
      "default": false
    },
    "priority_support": {
      "type": "boolean",
      "default": false
    },
    "analytics_access": {
      "type": "boolean",
      "default": false
    },
    "active": {
      "type": "boolean",
      "default": true
    },
    "display_order": {
      "type": "number",
      "default": 0
    },
    "invitation_only": {
      "type": "boolean",
      "default": false,
      "description": "If true, this plan can only be accessed via an invite code (e.g. Pro Beta Release)"
    },
    "created_at": {
      "type": "string",
      "format": "date-time",
      "default": "now()"
    },
    "updated_at": {
      "type": "string",
      "format": "date-time",
      "default": "now()"
    }
  },
  "required": [
    "name",
    "price"
  ]
}
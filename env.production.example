# Studio22 Production Environment Variables
# Copy this file to .env.production and fill in the actual values

# Base44 Configuration
VITE_BASE44_APP_ID=your_base44_app_id
VITE_BASE44_APP_BASE_URL=https://api.base44.app
VITE_PUBLISHABLE_KEY=your_publishable_key

# Brevo Email Service
VITE_BREVO_API_KEY=your_brevo_api_key
VITE_BREVO_SENDER_EMAIL=noreply@studio22.com
VITE_BREVO_SENDER_NAME=Studio22

# ChatGPT / OpenAI API
VITE_OPENAI_API_KEY=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

# WebSocket Configuration
VITE_WS_URL=wss://your-websocket-server.com

# Encryption
VITE_ENCRYPTION_KEY=your_secure_encryption_key_change_in_production

# Analytics (Optional)
VITE_ENABLE_ANALYTICS=true
VITE_ANALYTICS_ID=your_analytics_id

# Feature Flags
VITE_ENABLE_MAINTENANCE_MODE=false
VITE_ENABLE_2FA=true
VITE_ENABLE_RATE_LIMITING=true

# CDN Configuration
VITE_CDN_URL=https://cdn.studio22.com

# API Configuration
VITE_API_BASE_URL=https://api.studio22.com
VITE_API_TIMEOUT=30000

# Upload Configuration
VITE_MAX_FILE_SIZE=10485760
VITE_ALLOWED_IMAGE_TYPES=image/jpeg,image/png,image/webp
VITE_ALLOWED_VIDEO_TYPES=video/mp4,video/quicktime,video/webm

# Stripe Configuration (Public Key Only)
VITE_STRIPE_PUBLIC_KEY=your_stripe_public_key

# Environment
NODE_ENV=production
